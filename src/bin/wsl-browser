#!/bin/bash
# Pass the URL as data, never as PowerShell source or a cmd.exe command.
set -euo pipefail
if [[ $# -ne 1 || ! "$1" =~ ^https?:// ]]; then
  echo 'Usage: wsl-browser http(s)://URL' >&2
  exit 2
fi
printf '%s' "$1" | powershell.exe -NoProfile -NonInteractive -Command \
  '$ErrorActionPreference = "Stop"; $url = [Console]::In.ReadToEnd(); Start-Process -FilePath $url'
